-int SwosSdlInit(Uint32 f) { return SDL_Init(f) ? 0 : -1; }
+int SwosSdlInit(Uint32 f) {
+#ifdef __AROS__
+  /* AmigaDOS variables are not imported into SDL3's private environment.
+   * Forward explicit driver selections before SDL initializes a backend. */
+  static const char *names[] = { "SDL_AUDIODRIVER", "SDL_VIDEODRIVER" };
+  for (size_t i = 0; i < sizeof names / sizeof names[0]; ++i) {
+    const char *value = getenv(names[i]);
+    if (value && SwosSdlSetEnv(names[i], value, 1) != 0)
+      return -1;
+  }
+#endif
+  return SDL_Init(f) ? 0 : -1;
+}
