+#ifndef SWOS_SDL_H
+#define SWOS_SDL_H
+/* SDL2 reference or native SDL3 boundary. No SDL2 runtime is used by SDL3. */
+#ifndef SWOS_SDL3_BUILD
+#include <SDL.h>
