+#if SDL_VIDEO_OPENGL
+/* A native Intuition window does not need a different visual for OpenGL.
+ * Keep it when SDL enables GL for a renderer: recreation otherwise discards
+ * the client's fitted size and closes/reopens its public/custom screen. */
+static bool
+AROS_ReconfigureWindow(SDL_VideoDevice *_this, SDL_Window *window, SDL_WindowFlags flags)
+{
+    SDL_WindowData *data = window->internal;
+    (void)_this;
+    if (flags != SDL_WINDOW_OPENGL || (window->flags & SDL_WINDOW_EXTERNAL) ||
+        !data || !data->win) {
+        return SDL_Unsupported();
+    }
+    return true;
+}
+#endif
